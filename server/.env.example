# SERVER ENVIRONMENT TEMPLATE (safe to commit: placeholders only)
# Copy this file to .env and fill in real values locally.
# The real .env file is ignored by Git.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string.
# Atlas -> Database -> Connect -> Drivers -> copy the string, then put your
# database user and password in. Use a user limited to the AdaptEd database only.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-name>.mongodb.net/adapted?retryWrites=true&w=majority

# Long random string used to sign login tokens (for example 32+ random characters).
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Address of the React app (used for CORS).
CLIENT_URL=http://localhost:5173
